<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.peterzparker.mcpsimpletesttool</id>
    <name>Spring AI MCP Tool Tester</name>
    <vendor>peterzparker</vendor>
    <description><![CDATA[
        <p><b>Spring AI MCP Tool Tester</b> 是一款 IntelliJ IDEA 插件，为 Spring AI / MCP 开发者提供类似 Postman 的 <code>@Tool</code> 方法调试能力。</p>
        <h3>功能特性</h3>
        <ul>
            <li><b>MCP Server 连接管理</b>：通过 Settings 页面配置 SSE 端点 URL，管理与运行中的 MCP Server 的连接</li>
            <li><b>代码级快捷入口 (Gutter Icon)</b>：自动识别 <code>@Tool</code> 注解，提供一键跳转到调试面板</li>
            <li><b>Tool 调试面板</b>：多 Tab 页管理多个 Tool 的调试，支持 JSON 参数编辑、语法校验和结果展示</li>
            <li><b>异步通信</b>：所有 MCP 网络请求在后台线程执行，确保 IDE 流畅不卡顿</li>
        </ul>
        <h3>快速开始</h3>
        <ol>
            <li>打开 Settings → Tools → MCP Server，添加你的 MCP Server SSE URL</li>
            <li>打开 MCP Tool Runner 工具窗口，选择 Server 并点击 Connect</li>
            <li>连接成功后，自动加载工具列表，点击工具即可开始调试</li>
        </ol>
        <p>更多信息请访问 <a href="https://github.com/peterzparker/mcp-simple-test-tool">GitHub 仓库</a></p>
    ]]></description>

    <!-- 依赖 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window 调试面板 -->
        <toolWindow
            factoryClass="com.github.peterzparker.mcpsimpletesttool.toolWindow.MyToolWindowFactory"
            id="MCP Tool Runner"
            icon="AllIcons.RunConfigurations.TestState.Run"
            anchor="right"
        />

        <!-- MCP Server 配置设置页面 -->
        <applicationConfigurable
            parentId="tools"
            instance="com.github.peterzparker.mcpsimpletesttool.settings.McpServerSettingsConfigurable"
            displayName="MCP Server"
        />

        <!-- 持久化状态组件 -->
        <applicationService
            serviceImplementation="com.github.peterzparker.mcpsimpletesttool.services.McpServerSettingsState"
        />

        <!-- Gutter Icon 注解识别 -->
        <codeInsight.lineMarkerProvider
            language="java"
            implementationClass="com.github.peterzparker.mcpsimpletesttool.gutter.ToolAnnotationLineMarkerProvider"
        />
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="com.github.peterzparker.mcpsimpletesttool.gutter.ToolAnnotationLineMarkerProvider"
        />
    </extensions>
</idea-plugin>
